{
    "name": "@openhps/cli",
    "version": "1.0.3",
    "description": "OpenHPS Command Line Interface Tool",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenHPS/openhps-cli.git"
    },
    "bugs": {
        "url": "https://github.com/OpenHPS/openhps-cli/issues"
    },
    "homepage": "https://openhps.org",
    "publishConfig": {
        "access": "public"
    },
    "type": "commonjs",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "openhps-cli": "./dist/index.js"
    },
    "files": [
        "dist/**/*",
        "LICENSE"
    ],
    "scripts": {
        "start": "node dist/index.js",
        "clean": "shx rm -rf ./dist",
        "build": "npm run clean && tsc --build ./tsconfig/tsconfig.cli.json && shx cp -r src/templates dist/templates",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "test": "mocha --config test/.mocharc.json",
        "cover": "c8 mocha --config test/.mocharc.json",
        "cover:ci": "c8 mocha --config test/.mocharc.ci.json && c8 report --reporter=cobertura",
        "prepare": "husky",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:beta": "commit-and-tag-version --prerelease beta -m 'chore(beta): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog"
    },
    "keywords": [
        "openhps",
        "cli",
        "scaffolding",
        "positioning"
    ],
    "dependencies": {
        "@inquirer/prompts": "^8.5.2",
        "chalk": "^4.1.2",
        "ejs": "^3.1.10",
        "shelljs": "^0.10.0",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.34.0",
        "@types/chai": "^5.2.2",
        "@types/ejs": "^3.1.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "@types/shelljs": "^0.8.15",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "commit-and-tag-version": "^13.1.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^54.1.1",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "mocha": "^11.8.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
        "prettier": "^3.9.6",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2"
}
